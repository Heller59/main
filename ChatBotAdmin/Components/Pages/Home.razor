@page "/"
@using ChatBotAdmin.Data
@using ChatBotAdmin.Models
@using ChatBotAdmin.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject RateLimitAdminService RateSvc
@inject ChatSessionService SessionSvc
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Dashboard – @AppMeta.Name</PageTitle>

<div class="d-flex align-items-center gap-3 mb-4">
    <h1 class="mb-0">Dashboard</h1>
    @if (serviceConfig is not null && serviceOnline)
    {
        <a href="/rate-limits" class="text-decoration-none">
            <span class="badge-pill-success" style="font-size:.75rem;font-weight:500;padding:.35em .9em;display:inline-flex;align-items:center;gap:5px;">
                <span style="width:7px;height:7px;border-radius:50%;background:#529155;flex-shrink:0;"></span>Service Online
            </span>
        </a>
    }
</div>

@* ── Kill-switch banner (only when offline) ─────────────────────────────── *@
@if (serviceConfig is not null && !serviceConfig.ServiceEnabled)
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between gap-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-3">
            <span style="width:14px;height:14px;border-radius:50%;background:#fff;
                         box-shadow:0 0 0 3px rgba(255,255,255,.35);flex-shrink:0;
                         animation:rl-pulse 1.6s ease-in-out infinite;"
                  aria-hidden="true"></span>
            <div>
                <strong>ChatBots are OFFLINE.</strong>
                All requests are currently blocked.
                @if (!string.IsNullOrWhiteSpace(serviceConfig.UnavailableMessage))
                {
                    <span class="ms-2" style="opacity:.8;">— "@serviceConfig.UnavailableMessage"</span>
                }
            </div>
        </div>
        <a href="/rate-limits" class="btn btn-sm btn-light fw-semibold text-danger text-nowrap">Manage →</a>
    </div>
    <style>
        @@keyframes rl-pulse {
            0%, 100% { box-shadow: 0 0 0 3px rgba(255,255,255,.35); }
            50%       { box-shadow: 0 0 0 6px rgba(255,255,255,.10); }
        }
    </style>
}

@* ── Stat cards ─────────────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-primary">@total</div>
                <div class="text-muted small mt-1">Total Chat Bots</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-success">@ready</div>
                <div class="text-muted small mt-1">Ready</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-warning">@pending</div>
                <div class="text-muted small mt-1">Processing</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-danger">@errors</div>
                <div class="text-muted small mt-1">Errors</div>
            </div>
        </div>
    </div>
</div>

@* ── Bot list ────────────────────────────────────────────────────────────── *@
@if (allBots is null)
{
    <p class="text-muted">Loading…</p>
}
else if (allBots.Count == 0)
{
    <p class="text-muted">No ChatBots created yet. <a href="/chatbots/create">Create your first one.</a></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th class="text-center">Sessions</th>
                    <th>Created</th>
                    <th>Last Session</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bot in allBots)
                {
                    var count = sessionCounts.GetValueOrDefault(bot.Id, 0);
                    <tr>
                        <td><a href="/chatbots/@bot.Id" class="btn btn-outline-secondary btn-sm">View</a></td>
                        <td class="fw-semibold">@bot.Name</td>
                        <td><span class="badge bg-secondary">@bot.Version</span></td>
                        <td><StatusBadge Status="@bot.Status" /></td>
                        <td class="text-center">
                            @if (count > 0)
                            {
                                <a href="/chatbots/@bot.Id/sessions" class="badge bg-primary text-decoration-none">@count</a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-muted small">@bot.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                        <td class="text-muted small">
                            @if (lastActivity.TryGetValue(bot.Id, out var last))
                            {
                                @last.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DocumentChatBot>? allBots;
    private Dictionary<Guid, int> sessionCounts = [];
    private Dictionary<Guid, DateTime> lastActivity = [];
    private int total, ready, pending, errors;
    private RateLimitConfig? serviceConfig;
    private bool serviceOnline => serviceConfig?.ServiceEnabled ?? true;
    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        StartPollingIfNeeded();
    }

    private async Task Reload()
    {
        var botsTask     = Db.DocumentChatBots.OrderByDescending(x => x.CreatedAt).ToListAsync();
        var configTask   = RateSvc.GetGlobalConfigAsync();
        var countsTask   = SessionSvc.GetSessionCountsAsync();
        var activityTask = SessionSvc.GetLastActivityAsync();
        await Task.WhenAll(botsTask, configTask, countsTask, activityTask);

        allBots       = botsTask.Result;
        serviceConfig = configTask.Result;
        sessionCounts = countsTask.Result;
        lastActivity  = activityTask.Result;

        total   = allBots.Count;
        ready   = allBots.Count(x => x.Status == ProcessingStatus.Ready);
        pending = allBots.Count(x => x.Status is ProcessingStatus.Pending or ProcessingStatus.Processing);
        errors  = allBots.Count(x => x.Status == ProcessingStatus.Error);
    }

    private void StartPollingIfNeeded()
    {
        var anyProcessing = allBots?.Any(b =>
            b.Status is ProcessingStatus.Processing or ProcessingStatus.Pending) ?? false;

        if (anyProcessing && _pollTimer is null)
        {
            _pollTimer = new Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await Reload();
                    StateHasChanged();

                    if (allBots?.All(b =>
                        b.Status is not ProcessingStatus.Processing and not ProcessingStatus.Pending) ?? true)
                    {
                        _pollTimer?.Dispose();
                        _pollTimer = null;
                    }
                });
            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
    }

    public void Dispose() => _pollTimer?.Dispose();
}
