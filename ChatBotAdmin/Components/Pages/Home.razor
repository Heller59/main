@page "/"
@using ChatBotAdmin.Data
@using ChatBotAdmin.Models
@using ChatBotAdmin.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject RateLimitAdminService RateSvc
@rendermode InteractiveServer

<PageTitle>Dashboard – @AppMeta.Name</PageTitle>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active">Dashboard</li>
    </ol>
</nav>

<div class="d-flex align-items-center gap-3 mb-4">
    <h1 class="mb-0">Dashboard</h1>
    @if (serviceConfig is not null && serviceOnline)
    {
        <a href="/rate-limits" class="text-decoration-none">
            <span class="badge-pill-success" style="font-size:.75rem;font-weight:500;padding:.35em .9em;display:inline-flex;align-items:center;gap:5px;">
                <span style="width:7px;height:7px;border-radius:50%;background:#529155;flex-shrink:0;"></span>Service Online
            </span>
        </a>
    }
</div>

@* ── Kill-switch banner (only when offline) ─────────────────────────────── *@
@if (serviceConfig is not null && !serviceConfig.ServiceEnabled)
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between gap-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-3">
                <span style="width:14px;height:14px;border-radius:50%;background:#fff;
                         box-shadow:0 0 0 3px rgba(255,255,255,.35);flex-shrink:0;
                         animation:rl-pulse 1.6s ease-in-out infinite;"
                  aria-hidden="true"></span>
            <div>
                <strong>ChatBots are OFFLINE.</strong>
                All requests are currently blocked.
                @if (!string.IsNullOrWhiteSpace(serviceConfig.UnavailableMessage))
                {
                    <span class="ms-2" style="opacity:.8;">— "@serviceConfig.UnavailableMessage"</span>
                }
            </div>
        </div>
        <a href="/rate-limits" class="btn btn-sm btn-light fw-semibold text-danger text-nowrap">Manage →</a>
    </div>
    <style>
        @@keyframes rl-pulse {
            0%, 100% { box-shadow: 0 0 0 3px rgba(255,255,255,.35); }
            50%       { box-shadow: 0 0 0 6px rgba(255,255,255,.10); }
        }
    </style>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-primary">@total</div>
                <div class="text-muted small mt-1">Total Chat Bots</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-success">@ready</div>
                <div class="text-muted small mt-1">Ready</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-warning">@pending</div>
                <div class="text-muted small mt-1">Processing</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-danger">@errors</div>
                <div class="text-muted small mt-1">Errors</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/chatbots/create" class="btn btn-primary btn-sm">+ New Chat Bot</a>
</div>

@if (recent is null)
{
    <p class="text-muted">Loading…</p>
}
else if (recent.Count == 0)
{
    <p class="text-muted">No ChatBots created yet. <a href="/chatbots/create">Create your first one.</a></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bot in recent)
                {
                    <tr>
                        <td><a href="/chatbots/@bot.Id" class="btn btn-outline-secondary btn-sm">View</a></td>
                        <td>@bot.Name</td>
                        <td><span class="badge bg-secondary">@bot.Version</span></td>
                        <td><StatusBadge Status="@bot.Status" /></td>
                        <td class="text-muted small">@bot.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (total > 5)
    {
        <a href="/chatbots" class="btn btn-link p-0">View all @total →</a>
    }
}

@code {
    private List<DocumentChatBot>? recent;
    private int total, ready, pending, errors;
    private RateLimitConfig? serviceConfig;
    private bool serviceOnline => serviceConfig?.ServiceEnabled ?? true;

    protected override async Task OnInitializedAsync()
    {
        var botsTask   = Db.DocumentChatBots.OrderByDescending(x => x.CreatedAt).ToListAsync();
        var configTask = RateSvc.GetGlobalConfigAsync();
        await Task.WhenAll(botsTask, configTask);

        var all     = botsTask.Result;
        total       = all.Count;
        ready       = all.Count(x => x.Status == ProcessingStatus.Ready);
        pending     = all.Count(x => x.Status is ProcessingStatus.Pending or ProcessingStatus.Processing);
        errors      = all.Count(x => x.Status == ProcessingStatus.Error);
        recent      = all.Take(5).ToList();
        serviceConfig = configTask.Result;
    }
}
