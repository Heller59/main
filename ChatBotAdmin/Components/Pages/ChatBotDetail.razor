@page "/chatbots/{Id:guid}"
@using ChatBotAdmin.Models
@using ChatBotAdmin.Services
@inject DocumentChatBotService Svc
@inject NavigationManager Nav

<PageTitle>@(bot?.Name ?? "ChatBot") – ChatBot Admin</PageTitle>

@if (bot is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/chatbots">Document ChatBots</a></li>
            <li class="breadcrumb-item active">@bot.Name <span class="badge bg-secondary ms-1">@bot.Version</span></li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">@bot.Name</h1>
            <span class="text-muted small">Created @bot.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")</span>
        </div>
        <StatusBadge Status="@bot.Status" />
    </div>

    @if (bot.Status == ProcessingStatus.Error)
    {
        <div class="alert alert-danger mb-4">
            <strong>Processing Error:</strong> @bot.ErrorMessage
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Version</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@bot.Version</span></dd>

                        <dt class="col-sm-4 text-muted">Document</dt>
                        <dd class="col-sm-8 text-break">@bot.DocumentFileName</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8"><StatusBadge Status="@bot.Status" /></dd>

                        <dt class="col-sm-4 text-muted">Created</dt>
                        <dd class="col-sm-8">@bot.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Embed ID</div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Use this GUID when embedding the chat widget in an external site:</p>
                    <code class="d-block bg-light p-2 rounded text-break">@bot.Id</code>
                    <div class="mt-3">
                        <p class="text-muted small mb-1">Example embed script:</p>
                        <pre class="bg-light p-2 rounded small text-break"><code>&lt;script src="https://app.salespeak.ai/widget.js"
  data-org-id="@bot.Id"
  defer&gt;&lt;/script&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Model Instructions</div>
        <div class="card-body">
            <p class="mb-0" style="white-space: pre-wrap;">@bot.Instructions</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(bot.ExtractedText))
    {
        <div class="card mb-4">
            <div class="card-header fw-semibold d-flex justify-content-between">
                <span>Extracted Document Text</span>
                <span class="text-muted small fw-normal">@bot.ExtractedText.Length.ToString("N0") characters</span>
            </div>
            <div class="card-body">
                <pre class="small text-muted mb-0" style="max-height:400px; overflow-y:auto; white-space:pre-wrap;">@bot.ExtractedText</pre>
            </div>
        </div>
    }

    <div class="d-flex gap-2">
        <a href="/chatbots" class="btn btn-outline-secondary">← Back to list</a>
        <a href="/chatbots/create" class="btn btn-primary">Create new version</a>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DocumentChatBot? bot;

    protected override async Task OnInitializedAsync() =>
        bot = await Svc.GetByIdAsync(Id);
}
