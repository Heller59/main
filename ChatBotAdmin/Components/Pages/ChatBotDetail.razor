@page "/chatbots/{Id:guid}"
@using ChatBotAdmin.Models
@using ChatBotAdmin.Services
@using System.Text.Json
@inject DocumentChatBotService Svc
@inject NavigationManager Nav
@inject IConfiguration Config
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@(bot?.Name ?? "ChatBot") – @AppMeta.Name</PageTitle>

@if (bot is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/chatbots">Document Chat Bots</a></li>
            <li class="breadcrumb-item active">@bot.Name <span class="badge bg-secondary ms-1">@bot.Version</span></li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">@bot.Name</h1>
            <span class="text-muted small">Created @bot.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (polling)
            {
                <span class="spinner-border spinner-border-sm text-secondary" title="Checking status…"></span>
                <span class="text-muted small">Processing…</span>
            }
            <StatusBadge Status="@bot.Status" />
        </div>
    </div>

    @if (bot.Status == ProcessingStatus.Error)
    {
        <div class="alert alert-danger mb-4">
            <strong>Processing Error:</strong> @bot.ErrorMessage
        </div>
    }

    <div class="d-flex gap-2 mb-4">
        <a href="/chatbots" class="btn btn-outline-secondary">← Back to list</a>
        <a href="/chatbots/@bot.Id/edit" class="btn btn-primary">✏ Edit</a>
        <a href="/simulate/@bot.Id" target="_blank" class="btn btn-outline-secondary">▶ Simulator</a>
        <a href="/chatbots/@bot.Id/sessions" class="btn btn-outline-secondary">💬 Chat Sessions</a>
        <button class="btn btn-outline-danger ms-auto" @onclick="ConfirmDelete">Delete</button>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Version</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@bot.Version</span></dd>

                        <dt class="col-sm-4 text-muted">Document</dt>
                        <dd class="col-sm-8 text-break">@bot.DocumentFileName</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8"><StatusBadge Status="@bot.Status" /></dd>

                        <dt class="col-sm-4 text-muted">Created</dt>
                        <dd class="col-sm-8">@bot.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Embed ID</div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Use this GUID when embedding the chat widget in an external site:</p>
                    <code class="d-block bg-light p-2 rounded text-break">@bot.Id</code>
                    <div class="mt-3">
                        <p class="text-muted small mb-1">Example embed script:</p>
                        <pre class="bg-light p-2 rounded small text-break"><code>&lt;script src="@ChatBotServerBaseUrl/chatbot.js"
  data-org-id="@bot.Id"
  defer&gt;&lt;/script&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Widget Appearance</div>
        <div class="card-body">
            <div class="d-flex align-items-start gap-5 flex-wrap">

                <div>
                    <div class="fw-semibold small mb-2">Icon</div>
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(bot.IconPath))
                        {
                            <img src="@bot.IconPath" alt="Widget icon"
                                 style="width:56px;height:56px;object-fit:contain;border:1px solid #dee2e6;border-radius:8px;background:#f8f9fa;" />
                        }
                        else
                        {
                            <div style="width:56px;height:56px;border:2px dashed #dee2e6;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                <span class="text-muted small">None</span>
                            </div>
                        }
                    </div>
                    <div class="mt-2">
                        <a href="/chatbots/@bot.Id/edit" class="btn btn-outline-secondary btn-sm">Change in Edit</a>
                    </div>
                </div>

                <div>
                    <div class="fw-semibold small mb-2">Brand Color</div>
                    @if (!string.IsNullOrEmpty(bot.BrandColor))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:36px;height:36px;border-radius:6px;border:1px solid #dee2e6;background:@bot.BrandColor;flex-shrink:0;"></div>
                            <code class="small">@bot.BrandColor</code>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">Using default</span>
                    }
                    <div class="mt-2">
                        <a href="/chatbots/@bot.Id/edit" class="btn btn-outline-secondary btn-sm">Change in Edit</a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>Greeting</span>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(bot.Greeting))
                    {
                        <p class="text-muted small mb-0 fst-italic">No greeting set. The widget will open directly to the chat input.</p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-wrap;">@bot.Greeting</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>Document Notes</span>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(bot.Instructions))
                    {
                        <p class="text-muted small mb-0 fst-italic">No document notes provided.</p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-wrap;">@bot.Instructions</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>Chat Instructions</span>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(bot.ChatInstructions))
                    {
                        <p class="text-muted small mb-0 fst-italic">No chat instructions set. The AI will use default rules only.</p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space: pre-wrap;">@bot.ChatInstructions</p>
                    }
                </div>
            </div>
        </div>
    </div>

    var hasBothExtracted = !string.IsNullOrWhiteSpace(bot.ExtractedText) && ChunksWithImages.Count > 0;
    var extractedColClass = hasBothExtracted ? "col-md-6" : "col-12";

    @if (!string.IsNullOrWhiteSpace(bot.ExtractedText) || ChunksWithImages.Count > 0)
    {
        <div class="row g-4 mb-4">
            @if (!string.IsNullOrWhiteSpace(bot.ExtractedText))
            {
                <div class="@extractedColClass">
                    <div class="card h-100">
                        <div class="card-header fw-semibold d-flex justify-content-between">
                            <span>Extracted Document Text</span>
                            <span class="text-muted small fw-normal">@bot.ExtractedText.Length.ToString("N0") characters</span>
                        </div>
                        <div class="card-body">
                            <pre class="small text-muted mb-0" style="max-height:500px; overflow-y:auto; white-space:pre-wrap;">@bot.ExtractedText</pre>
                        </div>
                    </div>
                </div>
            }

            @if (ChunksWithImages.Count > 0)
            {
                <div class="@extractedColClass">
                    <div class="card h-100">
                        <div class="card-header fw-semibold d-flex justify-content-between">
                            <span>Extracted Images</span>
                            <span class="text-muted small fw-normal">
                                @ChunksWithImages.Sum(c => JsonSerializer.Deserialize<List<string>>(c.ImagePaths!)?.Count ?? 0) image(s)
                                across @ChunksWithImages.Count chunk(s)
                            </span>
                        </div>
                        <div class="card-body" style="max-height:500px; overflow-y:auto;">
                            @foreach (var chunk in ChunksWithImages)
                            {
                                var imagePaths = JsonSerializer.Deserialize<List<string>>(chunk.ImagePaths!) ?? [];
                                <div class="mb-3">
                                    <div class="text-muted small fw-semibold mb-2">@chunk.Heading (chunk @chunk.ChunkIndex)</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var url in imagePaths)
                                        {
                                            <a href="@url" target="_blank">
                                                <img src="@url"
                                                     alt="Document image from @chunk.Heading"
                                                     style="max-height:160px; max-width:240px; object-fit:contain; border:1px solid #dee2e6; border-radius:4px;" />
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showConfirm)
    {
        <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete ChatBot?</h5>
                    </div>
                    <div class="modal-body">
                        <p>This will permanently delete <strong>@bot.Name (@bot.Version)</strong>
                           and all @bot.ChunkCount embedded chunks. This cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="() => showConfirm = false">Cancel</button>
                        <button class="btn btn-danger" @onclick="DeleteConfirmed" disabled="@deleting">
                            @if (deleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Delete permanently
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DocumentChatBot? bot;

    // Base URL of the ChatBotServer that hosts chatbot.js — configured in appsettings.json
    private string ChatBotServerBaseUrl =>
        (Config["ChatBotServer:BaseUrl"] ?? "http://192.168.1.201:5017").TrimEnd('/');

    private List<DocumentChunk> ChunksWithImages =>
        bot?.Chunks.Where(c => !string.IsNullOrEmpty(c.ImagePaths)).ToList() ?? [];
    private bool showConfirm;
    private bool deleting;
    private bool polling;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        bot = await Svc.GetByIdAsync(Id);
        if (bot?.Status == ProcessingStatus.Processing)
            StartPolling();
    }

    private void StartPolling()
    {
        polling = true;
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(5000, ct);
                bot = await Svc.GetByIdAsync(Id);
                if (bot?.Status != ProcessingStatus.Processing)
                {
                    polling = false;
                }
                await InvokeAsync(StateHasChanged);
                if (!polling) break;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            polling = false;
        }
    }

    private void ConfirmDelete() => showConfirm = true;

    private async Task DeleteConfirmed()
    {
        deleting = true;
        await Svc.DeleteAsync(Id);
        Nav.NavigateTo("/chatbots");
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
