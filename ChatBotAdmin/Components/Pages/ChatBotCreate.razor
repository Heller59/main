@page "/chatbots/create"
@using ChatBotAdmin.Services
@inject DocumentChatBotService Svc
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>New Document ChatBot – ChatBot Admin</PageTitle>

<h1 class="h3 mb-4">New Document ChatBot</h1>

<div class="row">
    <div class="col-lg-7">
        <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="CreateChatBot">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-semibold">Name</label>
                <InputText @bind-Value="model.Name" class="form-control" placeholder="e.g. Employee Handbook" />
                <ValidationMessage For="() => model.Name" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Version</label>
                <InputText @bind-Value="model.Version" class="form-control" placeholder="e.g. V1.0" />
                <ValidationMessage For="() => model.Version" class="text-danger small" />
                <div class="form-text">If you need to revise, create a new version rather than editing this one.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Word Document (.docx)</label>
                <InputFile OnChange="HandleFileSelected" class="form-control" accept=".docx" />
                @if (!string.IsNullOrEmpty(selectedFileName))
                {
                    <div class="form-text text-success">Selected: @selectedFileName</div>
                }
                @if (!string.IsNullOrEmpty(fileError))
                {
                    <div class="text-danger small">@fileError</div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Widget Icon <span class="text-muted fw-normal">(optional)</span></label>
                <InputFile OnChange="HandleIconSelected" class="form-control" accept=".png,.jpg,.jpeg,.webp,.svg" />
                <div class="form-text">96×96 PNG with transparency recommended. Max 2 MB.</div>
                @if (!string.IsNullOrEmpty(iconFileName))
                {
                    <div class="form-text text-success">Selected: @iconFileName</div>
                }
                @if (!string.IsNullOrEmpty(iconError))
                {
                    <div class="text-danger small">@iconError</div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Greeting <span class="text-muted fw-normal">(optional)</span></label>
                <InputTextArea @bind-Value="model.Greeting" class="form-control" rows="2"
                               placeholder="e.g. Hi! I'm here to help answer questions about our product. What's your name?" />
                <div class="form-text">Shown in the widget when it first opens. A good greeting sets context and invites the user to share their name.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Document Notes <span class="text-muted fw-normal">(optional)</span></label>
                <InputTextArea @bind-Value="model.Instructions" class="form-control" rows="3"
                               placeholder="Describe what this document is, its domain, audience, etc. Gives the AI background context." />
                <div class="form-text">Used as background context about the document. Not a behavioural rule — use Chat Instructions for that.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Chat Instructions <span class="text-muted fw-normal">(optional)</span></label>
                <InputTextArea @bind-Value="model.ChatInstructions" class="form-control" rows="5"
                               placeholder="e.g. Answer only questions about login and account setup. Only include an image reference when the user asks about a screenshot or visual." />
                <div class="form-text">
                    Sent as the system prompt with every user question. Controls tone, scope, and image behaviour.
                    Use <code>[IMAGE: url]</code> is emitted by the AI automatically — instruct it when to do so here.
                </div>
            </div>

            @if (!string.IsNullOrEmpty(submitError))
            {
                <div class="alert alert-danger">@submitError</div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@busy">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Processing…</span>
                    }
                    else
                    {
                        <span>Create ChatBot</span>
                    }
                </button>
                <a href="/chatbots" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>

    <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
        <div class="card bg-light border-0">
            <div class="card-body">
                <h6 class="card-title">How this works</h6>
                <ol class="small text-muted ps-3 mb-0">
                    <li class="mb-2">Upload a Word document (.docx).</li>
                    <li class="mb-2">Give it a version label so you can track iterations.</li>
                    <li class="mb-2">Write instructions that tell the AI how to interpret the document.</li>
                    <li class="mb-2">The document is processed and saved. Your ChatBot ID is generated and ready to embed.</li>
                    <li>To make changes, create a new version — existing versions are read-only.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly CreateModel model = new();
    private IBrowserFile? selectedFile;
    private string selectedFileName = string.Empty;
    private string fileError = string.Empty;
    private IBrowserFile? iconFile;
    private string iconFileName = string.Empty;
    private string iconError = string.Empty;
    private string submitError = string.Empty;
    private bool busy;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        fileError = string.Empty;
        var file = e.File;

        if (!file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
        {
            fileError = "Only .docx files are supported.";
            selectedFile = null;
            selectedFileName = string.Empty;
            return;
        }

        if (file.Size > 50 * 1024 * 1024) // 50 MB
        {
            fileError = "File must be 50 MB or smaller.";
            selectedFile = null;
            selectedFileName = string.Empty;
            return;
        }

        selectedFile = file;
        selectedFileName = file.Name;
    }

    private void HandleIconSelected(InputFileChangeEventArgs e)
    {
        iconError = string.Empty;
        var file = e.File;
        var allowed = new[] { ".png", ".jpg", ".jpeg", ".webp", ".svg" };
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowed.Contains(ext))
        {
            iconError = "Only PNG, JPG, WebP, or SVG files are supported.";
            iconFile = null; iconFileName = string.Empty;
            return;
        }
        if (file.Size > 2 * 1024 * 1024)
        {
            iconError = "Icon must be 2 MB or smaller.";
            iconFile = null; iconFileName = string.Empty;
            return;
        }

        iconFile = file;
        iconFileName = file.Name;
    }

    private async Task HandleSubmit()
    {
        if (selectedFile is null)
        {
            fileError = "Please select a Word document.";
            return;
        }

        busy = true;
        submitError = string.Empty;

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var bot = await Svc.CreateAsync(
                model.Name,
                model.Version,
                model.Instructions,
                model.ChatInstructions,
                model.Greeting,
                stream,
                selectedFile.Name);

            if (iconFile is not null)
            {
                await using var iconStream = iconFile.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
                await Svc.SaveIconAsync(bot.Id, iconStream, iconFile.Name);
            }

            Nav.NavigateTo($"/chatbots/{bot.Id}");
        }
        catch (Exception ex)
        {
            submitError = $"An error occurred: {ex.Message}";
            busy = false;
        }
    }

    private sealed class CreateModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = "Sample Application";

        [System.ComponentModel.DataAnnotations.Required]
        public string Version { get; set; } = "V1.0";

        public string Greeting { get; set; } = string.Empty;
        public string Instructions { get; set; } = string.Empty;
        public string ChatInstructions { get; set; } = string.Empty;
    }
}
