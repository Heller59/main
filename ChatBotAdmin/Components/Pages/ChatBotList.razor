@page "/chatbots"
@using ChatBotAdmin.Models
@using ChatBotAdmin.Services
@inject DocumentChatBotService Svc
@inject ChatSessionService SessionSvc
@rendermode InteractiveServer

<PageTitle>Chat Bots – @AppMeta.Name</PageTitle>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active">Document Chat Bots</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="/chatbots/create" class="btn btn-primary">+ New ChatBot</a>
    <h1 class="h3 mb-0">Chat Bots</h1>
</div>

@if (bots is null)
{
    <p class="text-muted">Loading…</p>
}
else if (bots.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <p>No ChatBots yet.</p>
        <a href="/chatbots/create" class="btn btn-primary">Create your first one</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th class="text-center">Sessions</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bot in bots)
                {
                    var count = sessionCounts.GetValueOrDefault(bot.Id, 0);
                    <tr>
                        <td><a href="/chatbots/@bot.Id" class="btn btn-outline-secondary btn-sm">View</a></td>
                        <td class="fw-semibold">@bot.Name</td>
                        <td><span class="badge bg-secondary">@bot.Version</span></td>
                        <td><StatusBadge Status="@bot.Status" /></td>
                        <td class="text-center">
                            @if (count > 0)
                            {
                                <a href="/chatbots/@bot.Id/sessions" class="badge bg-primary text-decoration-none">
                                    @count
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-muted small">@bot.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DocumentChatBot>? bots;
    private Dictionary<Guid, int> sessionCounts = [];

    protected override async Task OnInitializedAsync()
    {
        var botsTask   = Svc.GetAllAsync();
        var countsTask = SessionSvc.GetSessionCountsAsync();
        await Task.WhenAll(botsTask, countsTask);
        bots          = botsTask.Result;
        sessionCounts = countsTask.Result;
    }
}
