@using ChatBotAdmin.Models

<span class="@CssClass">@Status</span>

@code {
    [Parameter, EditorRequired] public ProcessingStatus Status { get; set; }

    private string CssClass => Status switch
    {
        ProcessingStatus.Ready      => "badge-pill-success",
        ProcessingStatus.Processing => "badge-pill-warning",
        ProcessingStatus.Pending    => "badge-pill-info",
        ProcessingStatus.Error      => "badge-pill-danger",
        _                           => "badge-pill-info"
    };
}
