{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection schedule",
  "description": "One year of trash, recycling and bulk collection dates. Replace this file each year.",
  "type": "object",
  "required": [
    "year",
    "community",
    "township",
    "regularTrashDay",
    "trash",
    "recycling",
    "bulk"
  ],
  "additionalProperties": false,
  "properties": {
    "year": {
      "type": "integer",
      "minimum": 2020,
      "maximum": 2100
    },
    "community": {
      "type": "string",
      "minLength": 1
    },
    "township": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "string"
    },
    "regularTrashDay": {
      "type": "string",
      "enum": [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ]
    },
    "setOutHour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "recyclingHotline": {
      "type": "string"
    },
    "trash": {
      "$ref": "#/definitions/datedList"
    },
    "recycling": {
      "$ref": "#/definitions/datedList"
    },
    "bulk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "zones",
          "curbsideBy",
          "windowStart",
          "windowEnd"
        ],
        "additionalProperties": false,
        "properties": {
          "zones": {
            "type": "string",
            "description": "e.g. \"3-4\""
          },
          "curbsideBy": {
            "$ref": "#/definitions/isoDate",
            "description": "The Monday residents may start setting items out. Must be a Monday."
          },
          "windowStart": {
            "$ref": "#/definitions/isoDate"
          },
          "windowEnd": {
            "$ref": "#/definitions/isoDate"
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "definitions": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "datedList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "#/definitions/isoDate"
          },
          "note": {
            "type": "string",
            "description": "Shown in the app. Use for holiday shifts, e.g. \"Moved to Friday for Labor Day\"."
          }
        }
      }
    }
  }
}